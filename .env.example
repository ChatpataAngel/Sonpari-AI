# Sonpari-AI — local-first Telegram companion
# Copy this file to .env and set your own private Telegram credentials.
TELEGRAM_BOT_TOKEN=
OWNER_ID=
OWNER_USERNAME=
DB_PATH=data/sonpari.db
PERSONA_FILE=config/persona.yaml
RULES_FILES=config/rules.yaml
DEFAULT_LANG=hinglish
LOG_LEVEL=INFO
LOG_MESSAGE_CONTENT=false
ENABLE_PROACTIVE=true
QUIET_HOURS_START=23
QUIET_HOURS_END=8
PROACTIVE_MIN_INTERVAL_MINUTES=45
PROACTIVE_MAX_INTERVAL_MINUTES=180
MAX_MESSAGES_PER_MINUTE=12
SINGLE_USER_MODE=true

# External AI providers and adult/romantic modes are disabled in this edition.
