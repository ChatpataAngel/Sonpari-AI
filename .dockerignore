# .dockerignore for Aiko Bot v28+
# Exclude files not needed in container

.git
.gitignore
.env
.env.*
*.db
*.db-*
*.db-shm
*.db-wal
data/
*.json
!config/*.json
!aiko/conversation_library.json
!aiko/relationship_scenarios.json
!aiko/romance_conversation_bank_manifest.json
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.log
*.tmp
*.bak
*.swp
*~
.DS_Store
Thumbs.db
.vscode/
.idea/
*.egg-info/
dist/
build/
*.zip
*.tar.gz
*.rar
*.7z
*.pdf
*.docx
*.xlsx
*.jpg
*.jpeg
*.png
*.gif
*.mp3
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.apk
*.exe
*.msi
*.dmg
*.iso
*.bin
*.dat
*.psd
*.ai
*.sketch
*.fig
*.xd
*.svg
*.ico
*.ttf
*.woff
*.woff2
*.eot
*.otf
# Required read-only offline dialogue content (not private runtime data)
!aiko/data/
!aiko/data/content/
!aiko/data/content/*.json

data/backups/
*.sqlite3
*.sqlite3-*